# Rust
/target/
**/*.rs.bk

# V8 snapshot / build artifacts
*.bin

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs / runtime
*.log
cookie-store.json

# Local npx skills install artifacts / session state
.agents/
.claude/
skills-lock.json

# Local publisher tooling binary
mcp-publisher

# Local fetch/search SQLite cache (runtime state, must never rsync to hosted instance)
cache.db
cache.db-shm
cache.db-wal

# Local vendored source trees pulled for reference (e.g. deno_core during musl port)
vendor/

# Reports/notes stay local — docs under docs/ are never committed (user rule, 2026-09-22)
docs/**/*.md

# localStorage persistence test artifact (runtime state, must never rsync to hosted instance)
/localStorage/

# working docs & credentials — never committed
HANDOFF-*.md
scripts/__pycache__/
docs/aginx上传测试包_*.zip
docs/登录凭据_*.json
