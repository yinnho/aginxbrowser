{
  "vars": {
    "topic_id": 1000000
  },
  "steps": [
    {
      "id": "topic",
      "op": "http",
      "args": {
        "url": "https://www.v2ex.com/api/topics/show.json?id={{topic_id}}",
        "method": "GET",
        "headers": { "User-Agent": "aginxbrowser-flow/1.0" }
      },
      "save": "topic",
      "note": "单 id 查询 API 也返回数组（取 [0]）。topic_id 从帖子 URL v2ex.com/t/<id> 来"
    },
    {
      "id": "replies",
      "op": "http",
      "args": {
        "url": "https://www.v2ex.com/api/replies/show.json?topic_id={{topic_id}}&page=1",
        "method": "GET",
        "headers": { "User-Agent": "aginxbrowser-flow/1.0" }
      },
      "save": "replies",
      "note": "回复首页（每页 100 条，翻页改 page）。独立一步不塞进 topic 步——http 步一 url 一跳，复合留给调用方"
    }
  ]
}
